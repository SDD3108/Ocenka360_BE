[Unit]
Description=Ocenka 360 bounded background batch
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ocenka360
Group=ocenka360
WorkingDirectory=/opt/ocenka360/backend
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
EnvironmentFile=/etc/ocenka360/backend.env
ExecStart=/opt/ocenka360/venv/bin/python manage.py run_background_tasks --limit 5
TimeoutStartSec=10min
TimeoutStopSec=120
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ocenka360
