# Install under /etc/nginx/conf.d/ocenka360.conf (inside nginx http context).
# Replace EVERY api.example.invalid and certificate path AFTER obtaining TLS.
# Do not enable before nginx -t succeeds. app/database ports must stay private.
limit_req_zone $binary_remote_addr zone=ocenka_api:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=ocenka_auth:10m rate=5r/m;
log_format ocenka '$time_iso8601 $request_method $status $request_time request_id=$upstream_http_x_request_id';

server {
    listen 80;
    server_name api.example.invalid;
    return 301 https://api.example.invalid$request_uri;
}
server {
    listen 443 ssl;
    server_name api.example.invalid;
    ssl_certificate /etc/letsencrypt/live/api.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.example.invalid/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    # This example is a single hostname vhost, including when chosen as default.
    if ($host != api.example.invalid) { return 444; }
    access_log /var/log/nginx/ocenka360-access.log ocenka;
    error_log /var/log/nginx/ocenka360-error.log warn;
    client_max_body_size 22m;
    client_body_timeout 30s;
    limit_req_status 429;
    limit_req zone=ocenka_api burst=30 nodelay;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_read_timeout 100s;
    proxy_send_timeout 100s;
    proxy_connect_timeout 5s;
    proxy_cache off;
    proxy_buffering off;
    # Do not automatically replay financial or other writes after upstream errors.
    proxy_next_upstream off;
    location ~ ^/(private_media|media)/ { return 404; }
    location /api/v1/auth/ {
        limit_req zone=ocenka_auth burst=10 nodelay;
        limit_req zone=ocenka_api burst=30 nodelay;
        proxy_pass http://127.0.0.1:8001;
    }
    location / {
        proxy_pass http://127.0.0.1:8001;
    }
}
