# Generate a local secret with: python scripts/init_env.py
# No real keys belong in Git. Keep the production secret separate.
DJANGO_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Empty/unset DATABASE_URL uses db.sqlite3 in the project root (local only).
# DATABASE_URL=postgresql://ocenka360:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/ocenka360
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
# Leave blank until the legal name of the sole proprietor is confirmed.
COMPANY_LEGAL_NAME=
DEFAULT_FROM_EMAIL=Ocenka 360 <noreply@example.invalid>
