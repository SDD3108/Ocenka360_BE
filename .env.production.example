# TEMPLATE ONLY: all example.invalid domains must be replaced.
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=REPLACE_WITH_A_NEW_RANDOM_PRODUCTION_SECRET
DJANGO_ALLOWED_HOSTS=api.example.invalid
DATABASE_URL=postgresql://ocenka360:REPLACE_PASSWORD@db:5432/ocenka360
CORS_ALLOWED_ORIGINS=https://office.example.invalid
CSRF_TRUSTED_ORIGINS=https://api.example.invalid,https://office.example.invalid
TRUST_PROXY_HTTPS=False
COMPANY_LEGAL_NAME=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Ocenka 360 <noreply@example.invalid>

# Shared database-backed daily cap; failed deliveries consume quota too.
OTP_GLOBAL_DAILY_LIMIT=500

# Part 8: optional. Existing .env is never overwritten by an update.
# Empty bank configuration keeps real checkout unavailable.
PAYMENT_ADVANCE_KZT=2000.00
KASPI_PAYMENT_URL=
HALYK_ENABLED=False
HALYK_ENVIRONMENT=live
HALYK_CLIENT_ID=
HALYK_CLIENT_SECRET=
HALYK_TERMINAL_ID=
# HTTPS origin of this API, without path, and a fixed frontend return page.
PAYMENT_PUBLIC_ORIGIN=
PAYMENT_RETURN_URL=
